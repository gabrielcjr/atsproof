# Google Gemini API Key (Primary) - Get one free at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fallback) - Get one free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Rate Limiting & Concurrency Settings (Optional)
RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_REQUESTS=3
LOGFIRE_TOKEN=123